<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/plant_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:contentDescription="Plant image"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_plant_default" />

            <ImageView
                android:id="@+id/favorite_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Favorite"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/plant_image"
                android:src="@drawable/ic_favorite_border" />

            <TextView
                android:id="@+id/plant_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toBottomOf="@id/plant_image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/favorite_button"
                tools:text="Aloe Vera" />

            <!-- Остальная часть макета -->
            <!-- ... -->

            <TextView
                android:id="@+id/plant_species"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="italic"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/plant_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Aloe barbadensis miller" />

            <!-- Watering Information Section -->
            <TextView
                android:id="@+id/watering_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Watering Information"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/plant_species" />

            <TextView
                android:id="@+id/last_watered_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last watered:"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/watering_title"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/last_watered"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/last_watered_label"
                app:layout_constraintStart_toEndOf="@id/last_watered_label"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="May 1, 2023" />

            <TextView
                android:id="@+id/next_watering_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next watering:"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/last_watered"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/next_watering"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/next_watering_label"
                app:layout_constraintStart_toEndOf="@id/next_watering_label"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="May 7, 2023" />

            <Button
                android:id="@+id/water_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/water_now"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/next_watering" />

            <!-- Care Information Section -->
            <TextView
                android:id="@+id/care_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Care Information"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/water_button" />

            <TextView
                android:id="@+id/sunlight_needs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunlight needs:"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/care_title"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/sunlight_needs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/sunlight_needs_label"
                app:layout_constraintStart_toEndOf="@id/sunlight_needs_label"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Bright, indirect light" />

            <TextView
                android:id="@+id/soil_type_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soil type:"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/sunlight_needs"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/soil_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/soil_type_label"
                app:layout_constraintStart_toEndOf="@id/soil_type_label"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Well-draining soil" />

            <!-- Notes Section -->
            <TextView
                android:id="@+id/notes_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notes"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/soil_type" />

            <TextView
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/notes_title"
                tools:text="This plant is great for beginners and doesn't require much attention." />

            <Button
                android:id="@+id/delete_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/delete_plant"
                android:layout_marginTop="32dp"
                android:backgroundTint="@android:color/holo_red_light"
                app:layout_constraintTop_toBottomOf="@id/notes"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Перемещаем FAB за пределы NestedScrollView -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/edit_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Edit plant"
        android:src="@android:drawable/ic_menu_edit"
        app:layout_anchor="@id/plant_image"
        app:layout_anchorGravity="bottom|end" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>